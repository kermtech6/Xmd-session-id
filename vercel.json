{
  "version": 2,
  "functions": {
    "api/railway.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/qr", "destination": "/api/railway?path=/qr" },
    { "source": "/health", "destination": "/api/railway?path=/health" },
    { "source": "/api/status", "destination": "/api/railway?path=/api/status" },
    { "source": "/api/pairing-code", "destination": "/api/railway?path=/api/pairing-code" },
    { "source": "/api/reset", "destination": "/api/railway?path=/api/reset" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
